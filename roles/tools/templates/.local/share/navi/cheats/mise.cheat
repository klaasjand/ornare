% minikube, mise, local

# Install minikube locally for the current directory
mise use minikube@<version>

$ version: mise ls-remote minikube | sort -Vr | head -n 10

---

% kind, mise, local

# Install kind locally for the current directory
mise use kind@<version>

$ version: mise ls-remote kind | sort -Vr | head -n 15

